{
  "info": {
    "name": "AlmuerzoYa API",
    "description": "API REST de pedidos de almuerzo con JWT. Importar en Postman, revisar las variables de la colección y ejecutar en orden: Registrar/Login -> Crear pedido -> resto de endpoints. La petición '401 sin token' verifica la seguridad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "almuerzoId", "value": "1" },
    { "key": "email", "value": "ana@correo.com" },
    { "key": "password", "value": "almuerzo123" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario (devuelve token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Sandoval\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve token JWT', () => pm.expect(json.token).to.be.a('string'));",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión (devuelve token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve token JWT', () => pm.expect(json.token).to.be.a('string'));",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Estado 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Almuerzos",
      "item": [
        {
          "name": "401 sin token",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/almuerzos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Sin token responde 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos del usuario",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/almuerzos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cada pedido incluye total', () => {",
                  "  const datos = pm.response.json();",
                  "  if (datos.length) pm.expect(datos[0]).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/almuerzos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Carlos Pérez\",\n  \"plato\": \"Arroz con pato\",\n  \"cantidad\": 2,\n  \"precio\": 25.50,\n  \"entregado\": false\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Total calculado', () => pm.expect(json.total).to.eql(51));",
                  "if (json.id) pm.collectionVariables.set('almuerzoId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener pedido por id",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/almuerzos/{{almuerzoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el pedido solicitado', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('almuerzoId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar pedido / marcar entregado",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/almuerzos/{{almuerzoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Carlos Pérez\",\n  \"plato\": \"Arroz con pato\",\n  \"cantidad\": 3,\n  \"precio\": 25.50,\n  \"entregado\": true\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Pedido entregado', () => pm.expect(pm.response.json().entregado).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resumen del día (complementaria)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/almuerzos/resumen"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene cantidad y monto', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('cantidadAlmuerzos');",
                  "  pm.expect(json).to.have.property('montoTotal');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Anular pedido",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "url": "{{baseUrl}}/almuerzos/{{almuerzoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Estado 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
