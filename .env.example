# Copiar a .env (local) o cargar como variables de entorno en Render
# Base de datos MySQL local (por defecto):
DB_URL=jdbc:mysql://localhost:3306/almuerzoya?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=tu_password

# Si usas PostgreSQL en Render (Aiven, Supabase, Neon, etc.):
# DB_URL=jdbc:postgresql://HOST:5432/almuerzoya?sslmode=require
# DB_USER=usuario
# DB_PASSWORD=password
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT: usar una cadena aleatoria de al menos 32 caracteres
JWT_SECRET=cambia-esta-clave-por-una-secreta-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=3600000

# Render asigna PORT automáticamente; en local se usa 8080
PORT=8080
CORS_ALLOWED_ORIGINS=*
